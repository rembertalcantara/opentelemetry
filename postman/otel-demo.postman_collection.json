          "name": "Orders",
          "item": [
            {
              "name": "Place order \u2013 standard",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"expected: status is 201\", () => pm.response.to.have.status(201));",
                      "pm.test(\"X-Trace-Id header present\", () => pm.response.to.have.header(\"X-Trace-Id\"));",
                      "const body = pm.response.json();",
                      "pm.collectionVariables.set(\"orderId\", body.id);",
                      "pm.test(\"response has id and total\", () => { pm.expect(body.id).to.be.a(\"string\"); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"quantity\": {{quantity}},\n  \"customerId\": \"{{customerId}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{orderUrl}}/orders",
                  "host": [
                    "{{orderUrl}}"
